# Future Ready EMBA — production environment
# Copy this file to `.env.production` and fill in the real anon key BEFORE
# running `npm run build`. NEXT_PUBLIC_* values are inlined into the build,
# so this file MUST exist at build time (not just at runtime).

# The public site origin — drives canonical URLs, sitemap, JSON-LD, OG tags.
NEXT_PUBLIC_SITE_URL=https://futurereadymba.com

# Supabase lead capture (the anon key is public-by-design; safe on the client,
# protected by row-level security). Copy the same values from your existing
# .env.local / Vercel project.
NEXT_PUBLIC_SUPABASE_URL=https://jqlgtxaultqxdhlrmhwl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-supabase-anon-key-here
