# Future Ready EMBA — Hostinger production environment
# Configure these values in the Hostinger Node.js application settings.
# Never commit the real DB_PASSWORD or a populated .env.production file.

# The public site origin — drives canonical URLs, sitemap, JSON-LD, OG tags.
NEXT_PUBLIC_SITE_URL=https://futurereadymba.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEM-BhpyOxghbYJZ
TURNSTILE_VERIFY_URL=https://turnstile-siteverify-future-ready-mba.bisol-future-ready-mba.workers.dev/siteverify

# Hostinger MySQL lead capture. The production database is available locally
# to the Node.js application, so remote database access is not required.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u606386577_emba
DB_USER=u606386577_emba_app
DB_PASSWORD=paste-the-hostinger-database-password-here

# Private HMAC key for pseudonymous abuse fingerprints and daily lead deduplication.
# Generate at least 32 random bytes, store only in Hostinger, and never commit it.
LEAD_HASH_SECRET=paste-a-random-32-byte-or-longer-secret-here
