# Future Ready EMBA — Hostinger production environment
# Configure these values in the Hostinger Node.js application settings.
# Never commit the real DB_PASSWORD or a populated .env.production file.

# The public site origin — drives canonical URLs, sitemap, JSON-LD, OG tags.
NEXT_PUBLIC_SITE_URL=https://futurereadymba.com
# Optional verified entity URLs. Add only official URLs controlled by the named organisation.
NEXT_PUBLIC_PROVIDER_URL=
NEXT_PUBLIC_PROVIDER_LINKEDIN=
NEXT_PUBLIC_OPERATOR_LINKEDIN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEM-BhpyOxghbYJZ
TURNSTILE_VERIFY_URL=https://turnstile-siteverify-future-ready-mba.bisol-future-ready-mba.workers.dev/siteverify

# Search ownership and measurement. Copy only the verification token value,
# not the full meta tag. Leave blank until each account has been created.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional consent-gated Google Tag Manager container (for example GTM-ABC1234).
NEXT_PUBLIC_GTM_ID=

# IndexNow freshness submission. The key is public by protocol; the separate
# bearer secret protects the internal submission endpoint.
INDEXNOW_KEY=
INDEXNOW_CRON_SECRET=

# Hostinger MySQL lead capture. The production database is available locally
# to the Node.js application, so remote database access is not required.
DB_HOST=srv2132.hstgr.io
DB_PORT=3306
DB_NAME=u606386577_emba
DB_USER=u606386577_emba_app
DB_PASSWORD=paste-the-hostinger-database-password-here

# Private HMAC key for pseudonymous abuse fingerprints and daily lead deduplication.
# Generate at least 32 random bytes, store only in Hostinger, and never commit it.
LEAD_HASH_SECRET=paste-a-random-32-byte-or-longer-secret-here

# Transactional application acknowledgements. SMTP_PASSWORD is the password for
# support@futurereadymba.com; store it only in Hostinger's application environment.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@futurereadymba.com
SMTP_PASSWORD=paste-the-hostinger-mailbox-password-here
EMAIL_FROM_NAME=Future Ready Programme Team
EMAIL_REPLY_TO=support@futurereadymba.com
EMAIL_CRON_SECRET=paste-a-separate-random-32-byte-or-longer-secret-here

# Programme assistant. This credential is server-only; never use NEXT_PUBLIC_.
GROQ_API_KEY=paste-the-server-only-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
